# PostgreSQL Database URL
# Run `mise run db:up` to start and configure the repo-local PostgreSQL instance
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/vitrine

PORT=3001
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
FRONTEND_URL=http://localhost:3000

# Storage driver: "fs" (filesystem/Docker volume) or "s3" (MinIO/S3)
# "s3" requires MINIO_ROOT_USER, MINIO_ROOT_PASSWORD, MINIO_BUCKET_NAME,
# MINIO_ENDPOINT and MINIO_PUBLIC_URL — all mandatory when selected.
STORAGE_DRIVER=s3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_BUCKET_NAME=vitrine-bucket
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_URL=http://127.0.0.1:9000

# "fs" only:
# STORAGE_DRIVER=fs
# STORAGE_PATH=./storage

ENCRYPTION_SECRET=fjdsklfjsdlkjfosdjfklj34kkjkfsd09980f

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password_here

# Logging (optional)
# LOG_LEVEL=debug
# LOGTAIL_TOKEN=your_logtail_token_here
