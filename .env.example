# Required (compose refuses to start without them)
ENCRYPTION_SECRET=change-me-to-32-or-more-random-characters
# Domain the auth cookie is set on, must cover the API and the frontend (e.g. example.com)
COOKIE_DOMAIN=localhost

# Database
POSTGRES_PASSWORD=postgres

# Public URLs. The NEXT_PUBLIC_* and VITE_* ones are baked into the images at build time
BACKEND_URL=http://localhost:3001
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3001
VITE_API_URL=http://localhost:3001/trpc
VITE_SITE_URL=http://localhost:3000

# First admin account created on boot
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_FIRST_NAME=Admin
DEFAULT_ADMIN_LAST_NAME=User

# Storage: "fs" (disk volume) or "s3" (MinIO, the MINIO_* vars are then all required)
STORAGE_DRIVER=fs
STORAGE_PUBLIC_URL=http://localhost:3001
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_NAME=
MINIO_ENDPOINT=
MINIO_PUBLIC_URL=

# Logging (optional)
LOG_LEVEL=info
LOGTAIL_TOKEN=
