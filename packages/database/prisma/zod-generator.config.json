{
  "$schema": "../../../node_modules/prisma-zod-generator/lib/config/schema.json",
  "mode": "full",
  "output": "../src/zod",
  "useMultipleFiles": false,
  "singleFileName": "index.ts",
  "pureModels": true,
  "variants": {
    "pure": { "enabled": true },
    "input": { "enabled": true },
    "result": { "enabled": false }
  },
  "naming": {
    "preset": "zod-prisma-types",
    "input": {
      "exportNamePattern": "{InputType}Schema"
    }
  }
}
