model Project {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  weeks       Int
  link        String?
  cover       String
  video       String?
  gallery     String[]
  description String
  techStack   String[]
  date      DateTime
  services    String[]
  team        TeamMembers[]
  notes       String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
