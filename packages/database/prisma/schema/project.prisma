model Project {
  slug            String         @id
  position        Int            @unique
  name            String
  weeks           Int
  link            String?
  image           String
  video           String?
  coverEffect     String?
  description     Json
  metaDescription Json
  services        String[]
  team            StudioMember[]
  techStack       String[]
  date            String
  gallery         String[]
  notes           Json[]
  story           StorySection[]
  // grid elements set aside, shared by every section of the project
  bucket          Json           @default("[]")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}
